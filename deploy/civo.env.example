# Copy to deploy/civo.env (gitignored) or export these before ./deploy/deploy.sh
IMAGE_REPO=ghcr.io/shai200/salespage-chatbot
KUBECONFIG=./civo-love-kubeconfig
HOST=homerun.love
PUBLIC_BASE_URL=https://homerun.love
SERVE_SITES=1
# Leave unset so pages stay on the studio PVC (https://homerun.love/<slug>/)
# PAGE_RSYNC_TARGET=
# Optional: existing dockerconfigjson secret in namespace homerun
# IMAGE_PULL_SECRET=ghcr
# ./deploy/deploy.sh copies local data/studio.sqlite and sites/ onto the PVCs.
# Use --skip-sync to leave the cluster copies unchanged.
# Also applied onto the studio-app secret (same names as studio/config.py):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAGE_ANNUAL_PRICE_ID=
# HOMERUN_LEGACY_OWNER_EMAIL=
